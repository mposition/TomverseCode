      "path": "replay.js",
      "content": "// append-only \uc774\ubca4\ud2b8 \ub85c\uadf8\ub97c \uc7ac\uc0dd\ud574 \ud604\uc7ac \uc0c1\ud0dc\ub97c \ub9cc\ub4e0\ub2e4.\n//\n// \uc7ac\uc0dd\uc740 **\uc55e\uc73c\ub85c\ub3c4 \ud638\ud658\ub418\uc5b4\uc57c \ud55c\ub2e4**: \uc0c8 \ubc84\uc804\uc774 \ucd94\uac00\ud55c \uc774\ubca4\ud2b8 \ud0c0\uc785\uc744 \uc608\uc804 \ucf54\ub4dc\uac00 \ub9cc\ub098\uba74\n// \ub358\uc9c0\ub294 \ub300\uc2e0 \uac74\ub108\ub6f0\uace0 \uadf8 \uc0ac\uc2e4\uc744 \ub0a8\uae34\ub2e4. \ub358\uc9c0\uba74 \uacc4\uc815 \ud558\ub098\ub97c \uc544\uc608 \uc5f4 \uc218 \uc5c6\uac8c \ub41c\ub2e4.\nfunction amountCentsOf(payload) {\n  if (typeof payload?.amountCents === \"number\") return payload.amountCents;\n  // v1 payload\ub294 \uc6d0 \ub2e8\uc704 `amount`\uc600\ub2e4.\n  if (typeof payload?.amount === \"number\") return payload.amount * 100;\n  return 0;\n}\n\nfunction replay(events) {\n  const state = { balance: 0, closed: false, applied: 0, skipped: [] };\n  for (const event of events) {\n    // \ub2eb\ud78c \ub4a4\uc758 \uac70\ub798\ub294 \ubc18\uc601\ud558\uc9c0 \uc54a\ub294\ub2e4 \u2014 \uc21c\uc11c\uac00 \uc9c4\uc2e4\uc774\ub2e4.\n    if (state.closed && event.type !== \"CLOSED\") {\n      state.skipped.push(event.type);\n      continue;\n    }\n    switch (event.type) {\n      case \"DEPOSIT\":\n        state.balance += amountCentsOf(event.payload);\n        break;\n      case \"WITHDRAW\":\n        state.balance -= amountCentsOf(event.payload);\n        break;\n      case \"CLOSED\":\n        state.closed = true;\n        break;\n      default:\n        state.skipped.push(event.type);\n        continue;\n    }\n    state.applied += 1;\n  }\n  return state;\n}\nmodule.exports = { replay };\n"
    }
  ]
}
