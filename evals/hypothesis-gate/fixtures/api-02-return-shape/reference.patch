      "content": "// \uac80\uc0c9.\n//\n// **\ud55c \uac00\uc9c0 \ud615\ud0dc\ub9cc \ubc18\ud658\ud55c\ub2e4**: `{ ok, results, error? }`.\n// null/\ubb38\uc790\uc5f4/\ubc30\uc5f4 \uc138 \uac08\ub798\ub85c \ub098\ub258\uba74 \ud638\ucd9c\uc790\uac00 \ub9e4\ubc88 \uc138 \uacbd\uc6b0\ub97c \ubc29\uc5b4\ud574\uc57c \ud558\uace0, \ud55c \uacf3\uc774\ub77c\ub3c4\n// \ube60\ub728\ub9ac\uba74 \ub7f0\ud0c0\uc784\uc5d0 \ud130\uc9c4\ub2e4. \ube48 \uacb0\uacfc\ub294 \uc624\ub958\uac00 \uc544\ub2c8\ubbc0\ub85c `ok: true` + \ube48 \ubc30\uc5f4\uc774\ub2e4.\nfunction search(index, term) {\n  if (typeof term !== \"string\") {\n    return { ok: false, results: [], error: \"\uac80\uc0c9\uc5b4\ub294 \ubb38\uc790\uc5f4\uc774\uc5b4\uc57c \ud569\ub2c8\ub2e4\" };\n  }\n  return { ok: true, results: index.filter((entry) => entry.includes(term)) };\n}\nmodule.exports = { search };\n"
    }
  ]
}
