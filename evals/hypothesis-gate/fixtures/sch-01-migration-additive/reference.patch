      "content": "const CURRENT_VERSION = 2;\nconst DEFAULT_RETRIES = 3;\nconst DEFAULT_TIMEOUT_MS = 30000;\n\n// v1: { version: 1, name, retries }\n// v2: { version: 2, name, limits: { retries, timeoutMs } }\n//\n// **\ubc84\uc804\uc744 \ubcf4\uace0 \ubd84\uae30\ud55c\ub2e4.** \ubb34\uc870\uac74 \ubcc0\ud658\ud558\uba74 \uc774\ubbf8 v2\uc778 \uc124\uc815\uc758 \uac12\uc774 \uae30\ubcf8\uac12\uc73c\ub85c \ub36e\uc778\ub2e4.\nfunction migrate(config) {\n  const version = config.version ?? 1;\n  if (version > CURRENT_VERSION) {\n    throw new Error(\n      `\uc124\uc815 \ubc84\uc804 ${version}\uc740 \uc774 \uc571(${CURRENT_VERSION})\ubcf4\ub2e4 \uc0c8\ub86d\uc2b5\ub2c8\ub2e4 \u2014 \ub0ae\ucdb0\uc11c \uc5f4\uba74 \ub370\uc774\ud130\uac00 \uc190\uc0c1\ub429\ub2c8\ub2e4`\n    );\n  }\n  if (version === CURRENT_VERSION) return config;\n\n  return {\n    version: CURRENT_VERSION,\n    name: config.name,\n    limits: {\n      retries: config.retries ?? DEFAULT_RETRIES,\n      timeoutMs: DEFAULT_TIMEOUT_MS,\n    },\n  };\n}\nmodule.exports = { migrate, CURRENT_VERSION };\n"
    }
