      "path": "machine.js",
      "content": "const TERMINAL = new Set([\"COMPLETED\", \"FAILED\", \"CANCELLED\"]);\n\nconst TRANSITIONS = {\n  CREATED: [\"RUNNING\", \"CANCELLED\"],\n  RUNNING: [\"COMPLETED\", \"FAILED\", \"CANCELLED\"],\n  COMPLETED: [],\n  FAILED: [],\n  CANCELLED: [],\n};\n\nclass TaskMachine {\n  constructor() {\n    this.phase = \"CREATED\";\n    this.events = [];\n  }\n\n  /**\n   * \uc804\uc774 \uc2dc\ub3c4. \ud5c8\uc6a9\ub418\uc9c0 \uc54a\uc73c\uba74 **\uc544\ubb34\uac83\ub3c4 \ubc14\uafb8\uc9c0 \uc54a\uace0** false\ub97c \ubc18\ud658\ud55c\ub2e4.\n   * \ud130\ubbf8\ub110\uc5d0 \ub3c4\ub2ec\ud55c \ub4a4\uc5d0\ub294 \uc5b4\ub5a4 \uc804\uc774\ub3c4 \ubc1b\uc9c0 \uc54a\ub294\ub2e4 \u2014 \uc644\ub8cc\uc640 \ucde8\uc18c\uac00 \uacbd\uc7c1\ud574\ub3c4\n   * \uba3c\uc800 \ud655\uc815\ub41c \ucabd\ub9cc \ub0a8\ub294\ub2e4.\n   */\n  transition(to) {\n    if (this.isTerminal()) return false;\n    const allowed = TRANSITIONS[this.phase] ?? [];\n    if (!allowed.includes(to)) return false;\n    this.phase = to;\n    this.events.push(to);\n    return true;\n  }\n\n  isTerminal() {\n    return TERMINAL.has(this.phase);\n  }\n}\nmodule.exports = { TaskMachine, TRANSITIONS, TERMINAL };\n"
    }
  ]
