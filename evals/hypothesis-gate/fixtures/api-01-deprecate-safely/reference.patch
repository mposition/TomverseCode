      "content": "// \ubaa9\ub85d \uc9c8\uc758.\n//\n// \uc608\uc804 API: buildQuery({ sort: \"name\" })      \u2014 \ud56d\uc0c1 \uc624\ub984\ucc28\uc21c\n// \uc0c8 API:   buildQuery({ sort: { field: \"name\", direction: \"desc\" } })\n//\n// **\ub458 \ub2e4 \ubc1b\ub294\ub2e4.** \uacf5\uac1c API\ub97c \ubc14\uafc0 \ub54c \uc608\uc804 \ud615\ud0dc\ub97c \uc989\uc2dc \ub04a\uc73c\uba74 \ud638\ucd9c\uc790\uac00 \uc804\ubd80 \uae68\uc9c4\ub2e4.\n// \ub300\uc2e0 \uc608\uc804 \ud615\ud0dc\uc5d0\ub294 \uacbd\uace0\ub97c \ubd99\uc5ec \uc62e\uaca8\uac08 \uc774\uc720\ub97c \ub9cc\ub4e0\ub2e4 \u2014 \uc870\uc6a9\ud788 \ubc1b\uc544\uc8fc\uae30\ub9cc \ud558\uba74\n// \uc544\ubb34\ub3c4 \uc62e\uae30\uc9c0 \uc54a\uace0 \uc601\uc6d0\ud788 \ub458 \ub2e4 \uc720\uc9c0\ud574\uc57c \ud55c\ub2e4.\nconst DEFAULT_SORT = { field: \"id\", direction: \"asc\" };\n\nfunction buildQuery(options = {}) {\n  const warnings = [];\n  const sort = options.sort;\n\n  if (sort === undefined || sort === null) {\n    return { ...DEFAULT_SORT, warnings };\n  }\n  if (typeof sort === \"string\") {\n    warnings.push(\n      \"sort\uc5d0 \ubb38\uc790\uc5f4\uc744 \ub118\uae30\ub294 \ud615\ud0dc\ub294 deprecated\uc785\ub2c8\ub2e4. { field, direction } \uac1d\uccb4\ub97c \uc4f0\uc138\uc694.\"\n    );\n    return { field: sort, direction: \"asc\", warnings };\n  }\n  return {\n    field: sort.field ?? DEFAULT_SORT.field,\n    direction: sort.direction ?? \"asc\",\n    warnings,\n  };\n}\nmodule.exports = { buildQuery };\n"
    }
  ]
}
