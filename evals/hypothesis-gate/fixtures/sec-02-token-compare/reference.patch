      "content": "const { timingSafeEqual } = require(\"node:crypto\");\n\n/**\n * \ud1a0\ud070 \uac80\uc99d.\n *\n * \uc138 \uac00\uc9c0\ub97c \ud568\uaed8 \ubcf8\ub2e4:\n *  1. **\uc0c1\uc218 \uc2dc\uac04 \ube44\uad50** \u2014 \ubb38\uc790\ub9c8\ub2e4 \uc870\uae30 \ubc18\ud658\ud558\uba74 \uc5b4\ub290 \uc704\uce58\uae4c\uc9c0 \ub9de\uc558\ub294\uc9c0\uac00 \uc751\ub2f5 \uc2dc\uac04\uc73c\ub85c \uc0c8\uc5b4\n *     \ud55c \uae00\uc790\uc529 \uc54c\uc544\ub0bc \uc218 \uc788\ub2e4. \uae38\uc774 \ube44\uad50\ub3c4 \ub9c8\ucc2c\uac00\uc9c0\ub77c \uba3c\uc800 \ud574\uc2dc\ub85c \uae38\uc774\ub97c \uace0\uc815\ud55c\ub2e4.\n *  2. **\ub9cc\ub8cc** \u2014 \ud1a0\ud070\uc774 \ub9de\uc544\ub3c4 \uae30\uac04\uc774 \uc9c0\ub0ac\uc73c\uba74 \uac70\ubd80\ud55c\ub2e4.\n *  3. **\uc2a4\ucf54\ud504** \u2014 \uc778\uc99d(\ub204\uad6c\uc778\uac00)\uacfc \uc778\uac00(\ubb34\uc5c7\uc744 \ud560 \uc218 \uc788\ub294\uac00)\ub294 \ub2e4\ub978 \uc9c8\ubb38\uc774\ub2e4.\n */\nfunction verifyToken(provided, expected, options = {}) {\n  const a = Buffer.from(String(provided), \"utf8\");\n  const b = Buffer.from(String(expected), \"utf8\");\n\n  // \uae38\uc774\uac00 \ub2e4\ub974\uba74 timingSafeEqual\uc774 \ub358\uc9c0\ubbc0\ub85c, \uac19\uc740 \uae38\uc774\ub85c \ub9de\ucd98 \ub4a4 \uacb0\uacfc\uc5d0 \uae38\uc774 \uc77c\uce58\ub97c \uacf1\ud55c\ub2e4.\n  const length = Math.max(a.length, b.length, 1);\n  const padA = Buffer.alloc(length);\n  const padB = Buffer.alloc(length);\n  a.copy(padA);\n  b.copy(padB);\n  const contentEqual = timingSafeEqual(padA, padB) && a.length === b.length;\n  if (!contentEqual) return false;\n\n  if (options.expiresAt !== undefined && options.now !== undefined && options.now >= options.expiresAt) {\n    return false;\n  }\n  if (options.requiredScope !== undefined) {\n    const granted = options.grantedScopes ?? [];\n    if (!granted.includes(options.requiredScope)) return false;\n  }\n  return true;\n}\nmodule.exports = { verifyToken };\n"
    }
