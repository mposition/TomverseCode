      "content": "use std::path::{Component, Path, PathBuf};\n\n#[derive(Debug, PartialEq, Eq)]\npub enum Violation {\n    ParentTraversal,\n    OutsideRoot,\n    Empty,\n}\n\n/// \ud6c4\ubcf4 \uacbd\ub85c\ub97c \ub8e8\ud2b8 \uc548\uc73c\ub85c \uac00\ub454\ub2e4. \uc131\uacf5\ud558\uba74 \ub8e8\ud2b8 \uae30\uc900 \uc0c1\ub300 \uacbd\ub85c\ub97c \uc900\ub2e4.\n///\n/// \ub450 \uac00\uc9c0\ub97c \ubb38\uc790\uc5f4\uc774 \uc544\ub2c8\ub77c **\uacbd\ub85c \uad6c\uc131\uc694\uc18c**\ub85c \ud310\ub2e8\ud55c\ub2e4:\n///  - `..`\ub294 \uc138\uadf8\uba3c\ud2b8\uc77c \ub54c\ub9cc \uc704\ud5d8\ud558\ub2e4. `a..b.txt`\ub294 \uc815\uc0c1 \ud30c\uc77c \uc774\ub984\uc774\ubbc0\ub85c \ubb38\uc790\uc5f4 \ud3ec\ud568 \uac80\uc0ac\ub294 \uc624\ud0d0\uc774\ub2e4.\n///  - \uc808\ub300\uacbd\ub85c\ub294 `join`\uc774 \uc55e\uc744 \ud1b5\uc9f8\ub85c \ubc84\ub9ac\ubbc0\ub85c, \uc774\uc5b4 \ubd99\uc774\uae30 \uc804\uc5d0 \ub8e8\ud2b8 \uc548\uc778\uc9c0 \ub530\ub85c \ud655\uc778\ud574\uc57c \ud55c\ub2e4.\npub fn confine(root: &Path, candidate: &str) -> Result<String, Violation> {\n    if candidate.trim().is_empty() {\n        return Err(Violation::Empty);\n    }\n    let candidate_path = Path::new(candidate);\n\n    if candidate_path\n        .components()\n        .any(|c| matches!(c, Component::ParentDir))\n    {\n        return Err(Violation::ParentTraversal);\n    }\n\n    let joined: PathBuf = if candidate_path.is_absolute() {\n        if !candidate_path.starts_with(root) {\n            return Err(Violation::OutsideRoot);\n        }\n        candidate_path.to_path_buf()\n    } else {\n        root.join(candidate_path)\n    };\n\n    let relative = joined.strip_prefix(root).map_err(|_| Violation::OutsideRoot)?;\n    Ok(relative\n        .components()\n        .filter(|c| !matches!(c, Component::CurDir))\n        .map(|c| c.as_os_str().to_string_lossy().to_string())\n        .collect::<Vec<_>>()\n        .join(\"/\"))\n}\n"
    }
  ]
